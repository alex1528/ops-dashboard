datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id         String   @id @default(cuid())
  username   String   @unique
  password   String // bcrypt hash
  email      String   @default("")
  role       String   @default("user") // admin | user
  mfaSecret  String   @default("") // TOTP secret, encrypted
  mfaEnabled Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  permissions UserPermission[]
}

model UserPermission {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "group" | "resource"
  target    String   // group name or resource id
  createdAt DateTime @default(now())

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, target])
  @@index([userId])
}

model Resource {
  id          String   @id @default(cuid())
  name        String
  url         String
  group       String   @default("default")
  groupSortOrder      Int      @default(0)
  description String   @default("")
  sortOrder           Int      @default(0)
  enabled             Boolean  @default(true)
  healthCheckEnabled  Boolean  @default(true)
  ownerId             String?  // null = admin-created; userId = user-created
  createdAt           DateTime @default(now())
  updatedAt   DateTime @updatedAt

  credential    Credential?
  healthRecords HealthRecord[]
}

model Credential {
  id         String   @id @default(cuid())
  resourceId String   @unique
  username   String // encrypted — Web system login username
  password   String // encrypted — Web system login password
  extra      String   @default("") // encrypted JSON for additional fields
  privateKey String   @default("") // encrypted PEM private key (Linux SSH)
  sshEnabled Boolean  @default(false) // whether Web Terminal (SSH) is enabled
  webLoginEnabled Boolean @default(false) // whether auto-login to Web system is enabled
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
}

model HealthRecord {
  id         String   @id @default(cuid())
  resourceId String
  status     String // up | down | unknown
  statusCode Int?
  responseMs Int?
  error      String?
  checkedAt  DateTime @default(now())

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId, checkedAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String // e.g. "credential.view", "credential.update", "resource.create"
  targetId  String?
  detail    String   @default("")
  ip        String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model SystemSetting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
}
