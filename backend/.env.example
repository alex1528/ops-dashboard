# Database
DATABASE_URL="file:./data/ops-dashboard.db"

# JWT
JWT_SECRET="CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS"
JWT_EXPIRES_IN="24h"

# Credential encryption master key (32 bytes hex = 64 chars)
MASTER_KEY="CHANGE_ME_0123456789abcdef0123456789abcdef0123456789abcdef01234567"

# Admin initial credentials (only used on first run seed)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="CHANGE_ME_strong_password"

# Health check
HEALTH_CHECK_INTERVAL_MS="60000"
HEALTH_CHECK_TIMEOUT_MS="10000"

# Backup
BACKUP_ENABLED="true"
BACKUP_CRON="0 3 * * *"
# BACKUP_DIR defaults to ../backup relative to the data dir

# Server
PORT=3000

# ==========================================
# OIDC / Authentik（可选，不填则 OIDC 登录不启用）
# ==========================================
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=[REDACTED_PASSWORD]
OIDC_REDIRECT_URI=
OIDC_ADMIN_GROUP="ops-admin"
OIDC_SCOPES="openid profile email"
OIDC_FRONTEND_URL=
