#!/bin/sh

set -eu

if [ "${SKIP_AUTO_TAG:-0}" = "1" ]; then
    exit 0
fi

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    exit 0
fi

if git tag --points-at HEAD | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+$'; then
    exit 0
fi

# Use git tag --sort to find the latest semver tag by version order.
# This is more robust than git describe, which can break when the tag
# object's internal name doesn't match the ref name.
last_tag="$(git tag -l 'v[0-9]*.[0-9]*.[0-9]*' --sort=-version:refname | head -1)"

if [ -n "$last_tag" ]; then
    base_version="${last_tag#v}"
else
    base_version="0.0.0"
fi

IFS='.' read -r major minor patch <<EOF
$base_version
EOF

patch=$((patch + 1))
if [ "$patch" -ge 10 ]; then
    patch=0
    minor=$((minor + 1))
fi

if [ "$minor" -ge 10 ]; then
    minor=0
    major=$((major + 1))
fi

next_tag="v${major}.${minor}.${patch}"

if [ "${1:-}" = "--dry-run" ]; then
    printf '%s\n' "$next_tag"
    exit 0
fi

git tag -a "$next_tag" -m "Auto tag $next_tag"