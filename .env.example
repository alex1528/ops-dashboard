# ==========================================
# Ops Dashboard 环境变量配置
# 复制此文件为 .env 并修改各项值
# ==========================================

# JWT 密钥 (至少32位随机字符串)
# 生成方法: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_PLEASE_USE_OPENSSL_RAND

# JWT 过期时间
JWT_EXPIRES_IN=24h

# 凭据加密主密钥 (64位 hex = 32 byte)
# 生成方法: openssl rand -hex 32
MASTER_KEY=CHANGE_ME_0123456789abcdef0123456789abcdef0123456789abcdef01234567

# 初始管理员 (仅首次 seed 使用)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_strong_password

# 健康检查间隔 (毫秒)
HEALTH_CHECK_INTERVAL_MS=60000
HEALTH_CHECK_TIMEOUT_MS=10000

# 数据库自动备份
BACKUP_ENABLED=true
# 备份 cron 表达式 (默认每天凌晨 3 点)
BACKUP_CRON=0 3 * * *

# 服务端口
PORT=6000

# ==========================================
# SMTP 邮件通知（可选，不填则禁用邮件功能）
# ==========================================

# SMTP 服务器地址（留空则禁用邮件功能）
SMTP_HOST=smtp.example.com

# SMTP 端口（465 = SSL/TLS，587 = STARTTLS）
SMTP_PORT=465

# SMTP 登录用户名
SMTP_USER=ops@example.com

# SMTP 登录密码
SMTP_PASS=your-password

# 发件人地址（默认与 SMTP_USER 相同）
SMTP_FROM=ops@example.com

# ==========================================
# Docker 构建参数（通过 build.sh / build.ps1 自动注入，一般不需要手动设置）
# ==========================================

# 系统版本号（由构建脚本自动从 git tag 读取并注入为 Docker build arg）
# APP_VERSION=v1.0.0

# ==========================================
# OIDC / Authentik 单点登录（可选，不填则 OIDC 登录不启用）
# ==========================================

# Authentik OpenID Provider 的 Issuer URL
# 例如: https://authentik.example.com/application/o/ops-dashboard
OIDC_ISSUER=

# OAuth2 Client ID（在 Authentik Provider 中创建后获取）
OIDC_CLIENT_ID=

# OAuth2 Client Secret（Confidential 类型）
OIDC_CLIENT_SECRET=[REDACTED_PASSWORD]
# 回调地址（必须与 Authentik 中配置的 Redirect URI 完全一致）
# 格式: https://your-ops-domain.com/api/oidc/callback
OIDC_REDIRECT_URI=

# Authentik 中映射为 admin 角色的组名（不属于该组则为 user 角色）
OIDC_ADMIN_GROUP=ops-admin

# 请求的 OIDC 作用域（需包含 groups 以获取组信息）
OIDC_SCOPES=openid profile email

# 前端基础 URL（回调后重定向用，留空则使用相对路径）
# 例如: https://your-ops-domain.com
OIDC_FRONTEND_URL=
